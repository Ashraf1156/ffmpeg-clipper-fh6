# StreamCut R2 Secrets Configuration Template
# Copy this file to secrets.toml and fill in your actual credentials.

[r2]
account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"
access_key_id = "YOUR_R2_ACCESS_KEY_ID"
secret_access_key = "YOUR_R2_SECRET_ACCESS_KEY"
bucket_name = "YOUR_R2_BUCKET_NAME"
public_domain = "https://pub-xxxx.r2.dev"

[zernio]
api_key = "YOUR_ZERNIO_API_KEY"

[platforms]
instagram_account_id = "YOUR_INSTAGRAM_ACCOUNT_ID"
youtube_account_id = "YOUR_YOUTUBE_ACCOUNT_ID"
